{
  "name": "webdev-template-python-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "bun install --frozen-lockfile",
    "dev": "bun --bun next dev --port 3000",
    "check": "bun run lint && bun run typecheck",
    "lint": "bun --bun eslint . --max-warnings 0",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "build": "bun --bun next build",
    "start": "bun --bun next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "shadcn": "^4.21.4"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "description": "Bun and Next.js frontend for a FastAPI and uv web app.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  }
}
